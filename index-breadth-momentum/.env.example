# Telegram bot, created with @BotFather (/newbot). Looks like 123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=

# Your chat id. Send any message to the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_CHAT_ID=

# Optional. Predictions above this many R trigger BUY; below it, WAIT or SELL.
SIGNAL_THRESHOLD=0.0

# Optional. Timezone used in the alert header.
SIGNAL_TIMEZONE=America/New_York
