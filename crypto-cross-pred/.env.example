# Copy to .env and fill in what you need. `.env` is gitignored (AGENTS.md section 7).
# In CI these come from GitHub Actions secrets, not from this file.

# Hugging Face Datasets — dataset upload/download
HF_TOKEN=
HF_DATASET_REPO=

# Binance testnet — bonus only, never real funds
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram alerts — bonus only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Not needed: FRED is read through pandas-datareader without a key.
# Uncomment only if you switch to fredapi.
# FRED_API_KEY=
